  "milestones": [
    {
      "id": "M0",
      "title": "Baseline and safe setup",
      "goal": "No product rewrite; baseline and synchronization are understood before fixes."
    },
    {
      "id": "M1",
      "title": "Paths, ordering and native execution",
      "goal": "Reliable argument boundaries, dependency selection, deterministic order and bounded commands."
    },
    {
      "id": "M2",
      "title": "PDF validation and non-destructive results",
      "goal": "Sources/existing outputs stay safe; partial success cannot masquerade as full success."
    },
    {
      "id": "M3",
      "title": "Focused usability and honest documentation",
      "goal": "Preserved defaults, small parameter set, useful diagnostics and measured PDF limitations."
    },
    {
      "id": "M4",
      "title": "Regression, CI and Windows acceptance",
      "goal": "Required real Windows/native evidence plus scoped, truthful compatibility claims."
    },
    {
      "id": "M5",
      "title": "Packaging and accepted release source",
      "goal": "Reviewed package workflow and merged immutable release-source commit R."
    },
    {
      "id": "M6",
      "title": "Publish, verify and close",
      "goal": "Only v1.0.0 is publicly released; exact assets, downloaded operation and final sync are verified."
    }
