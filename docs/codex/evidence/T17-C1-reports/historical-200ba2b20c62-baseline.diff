+Describe 'AC040 import-only binary byte formatting' {
+    It 'formats <Bytes> bytes as <Expected>' -TestCases @(
+        @{Bytes=[long]0;Expected='0 B'},
+        @{Bytes=[long]1023;Expected='1023 B'},
