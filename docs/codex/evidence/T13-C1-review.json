  "CodeReview": {
    "Result": "no_blocking_findings",
    "BlockingFindings": [],
    "ObservedChecks": [
      "Every PDFtk merge requires a positive explicit frozen expected page count before stage creation or native launch. Binding that parameter for Ghostscript is refused.",
      "Successful merge execution and a nonempty regular owned staged master precede the existing bounded envelope, PDFtk dump_data_utf8 and strict positive Int64 page-count inspector.",
      "Separate validation receipt must report success, started process, exit zero, no timeout/cancel/launch/capture/termination failures and complete stdout/stderr.",
      "Inspected page count must equal the frozen total before OutputValidated is set or final publication is attempted.",
      "Staging ownership, stage and destination identities, reparse status and staged length/last-write metadata are checked around inspection.",
      "Publication and cleanup reuse unchanged T12 owned staging and no-overwrite File.Move helpers.",
      "Merge and inspection receipts stay separate. Final publication state remains false on refused inspection or collision.",
      "Entry labels pre-run output as planned, rechecks frozen inputs immediately before merge, logs both native receipts, and announces validated publication only after successful gate and move.",
      "Ghostscript work follows successful master validation and publication; its structural and smaller-only gate remains T14.",
      "No new runtime network calls, replacement engines, defaults, recursive cleanup, source mutation or framework were introduced. Syntax remains compatible with Windows PowerShell 5.1."
    ],
    "TestDesignReview": [
      "New 38-case unit suite covers missing/empty/non-PDF/truncated/directory staged output, strict malformed/zero/duplicate/overflow labels, wrong expected total, incomplete/failing inspection receipts, inspector exceptions, changed staging ownership or metadata and final collision.",
      "Unit rejection cases assert no publication, preserved input and foreign hashes, and owned cleanup where applicable. Controlled native receipts are not claimed as native structural acceptance.",
      "Existing 12-case invocation tier explicitly isolates wiring through mocked inspection while actual PDFtk path/staging tiers supply expected totals and retain separate real validation receipts.",
      "New seven-case native tier uses actual entry runs for single multipage and natural 1/01/2/10 ordering with rotated owned fixture derivatives; independent pinned PDFium checks visible IDs, rotation units and page dimensions.",
      "Native invalid-data substitutions explicitly disclose controlled scheduling after actual PDFtk merge success and before the original real inspector. Missing/empty/non-PDF fail before native inspection; valid wrong-page data invokes real inspection.",
      "Two existing refusal assertions now forbid Master validation OK and Merged master published text, extending nine dependency and 22 input-preflight cases without increasing their counts."
    ],
    "NonblockingFindings": [
      {
        "Category": "Test fixture naming",
        "Detail": "Eight analyzer findings concern assigning the automatic variable input in isolated fixture tests, including three new master cases. Rename when these tests are next edited; reviewed direct non-pipeline usage does not weaken the runtime validation gate."
      }
    ]
  },
