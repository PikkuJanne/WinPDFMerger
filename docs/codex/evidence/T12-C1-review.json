  "CodeReview": {
    "Result": "no_blocking_findings",
    "BlockingFindings": [],
    "ObservedChecks": [
      "Atomic Windows create-new directory reservation cannot acquire ownership after a stage collision.",
      "Create-new ownership marker is readable and held without write/delete sharing.",
      "Stage and destination physical identities and reparse checks precede publication and cleanup.",
      "Known staged files publish only through two-argument no-overwrite File.Move in the original destination parent.",
      "Cleanup enumerates only the owned stage, refuses unknown/reparse children, deletes only known temporary files, and removes the empty directory without recursion.",
      "Marker restoration is guarded by markerDeleted, original stage and parent identity checks, and CreateNew.",
      "Entry uses one stage for master/email with finally cleanup and explicit email publication state.",
      "No runtime network calls, engine/default changes, source edits, broad cleanup, or release actions were added.",
      "Helpers remain import-only with compatible PowerShell 5.1 syntax."
    ],
    "TestDesignReview": [
      "Unit coverage includes stage file/directory collision, readable immutable marker, live stage isolation, known-only cleanup, unknown children and prefix siblings, locked staged file, disposed/changed ownership, literal final paths and final file/directory collisions.",
      "Late unknown child cleanup faults verify marker restoration for unchanged identity and refusal after changed identity.",
      "Native collision wrappers disclose controlled scheduling and invoke the original helper to perform a real no-overwrite move after actual PDFtk/Ghostscript success.",
      "Concurrent native test children share an explicit fixed timestamp/start barrier and demonstrate first-run cleanup leaves second-run held temporary bytes unchanged."
    ]
  },
